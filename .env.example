# Password for /admin, where nominations, applications, RSVPs and subscribers are listed.
# Leave unset to disable the admin area.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie.
ADMIN_SECRET=
# Public address of the site, used for the sitemap and social links (e.g. https://amazingemiratis.ae).
SITE_URL=
# Optional: where the SQLite database and uploaded portraits are stored (default ./data).
DATA_DIR=
